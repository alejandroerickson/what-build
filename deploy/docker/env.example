# Copy to .env beside compose.yaml and whatbuild-e2e.sh, and fill in. .env stays on the host.

# The absolute path of the folder holding these files; data/ is made under it.
WHATBUILD_E2E_DIR=/path/to/whatbuild-e2e

# The image and the repository whose releases it follows. A private image needs `docker login
# ghcr.io` on the host first, with a token that reads packages.
WHATBUILD_IMAGE=ghcr.io/<owner>/what-build
WHATBUILD_REPO=<owner>/what-build

# The local Postgres's password, for its superuser and the application's role. Letters and digits
# only, since it goes into a URL: `openssl rand -hex 24`.
WHATBUILD_E2E_PG_PASSWORD=

# The host's loopback port the app answers on, and the address the tests use: the tunnel's end
# on the machine that runs them (ssh -N -L 5293:127.0.0.1:5283 <host>).
WHATBUILD_E2E_PORT=5283
WHATBUILD_E2E_PUBLIC_URL=http://localhost:5293

# The updater (docker compose --profile updater up -d): when it looks for a newer release, in
# the updater's time zone (UTC), and where the host keeps its registry login.
WHATBUILD_E2E_UPDATE_CRON=0 11 * * *
WHATBUILD_E2E_DOCKER_CONFIG=/root/.docker

# Written by whatbuild-e2e.sh update.
WHATBUILD_TAG=
