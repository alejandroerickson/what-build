{
  "name": "what-build",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "tsx apps/server/src/dev.ts",
    "dev:fixture": "tsx apps/server/src/dev.ts --fixture",
    "dev:e2e": "tsx apps/server/src/dev.ts --e2e",
    "fixture": "tsx apps/server/src/fixture.ts",
    "e2e": "tsx apps/server/src/e2e.ts",
    "build": "apps/web/node_modules/.bin/vite build apps/web && node apps/server/build.mjs",
    "start": "node apps/server/dist/main.js serve",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/parsers && tsc -p packages/core && tsc -p apps/server && tsc -p apps/web",
    "db:migrate": "NODE_ENV=development tsx apps/server/src/main.ts migrate",
    "db:seed": "NODE_ENV=development tsx apps/server/src/main.ts seed",
    "gen:skill": "node scripts/gen-skill.mjs",
    "security": "node scripts/security.mjs",
    "check:publishable": "node scripts/check-publishable.mjs",
    "attention": "node scripts/attention.mjs",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3",
    "tsx": "^4.20.6",
    "playwright-core": "^1.56.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@embedded-postgres/darwin-arm64",
      "@embedded-postgres/darwin-x64",
      "@embedded-postgres/linux-x64",
      "@embedded-postgres/linux-arm64"
    ]
  }
}
